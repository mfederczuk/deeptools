{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		// Modules
		"rootDir": "src",

		// Emit
		"declaration": true,
		"declarationDir": "types",
		"outDir": "out",
		"removeComments": true,
	},
	"include": ["src"],
}
